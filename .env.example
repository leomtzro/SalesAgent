# Required: your Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the models used.
# PROSPECTOR_MODEL is the researcher/writer. PROSPECTOR_EXTRACT_MODEL turns
# research notes into structured records - a cheaper model is usually fine here.
# PROSPECTOR_MODEL=claude-opus-5-5
# PROSPECTOR_EXTRACT_MODEL=claude-opus-5-5

# Optional: cap how many web searches each prospect may cost
# PROSPECTOR_MAX_SEARCHES=12

# Optional: paid email-finder fallback, used only if set.
# Get one at https://hunter.io - without it the agent infers emails from
# the company's published address pattern and labels them as guesses.
# HUNTER_API_KEY=
